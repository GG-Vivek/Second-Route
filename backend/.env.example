# SecondRoute Backend Environment Variables
# Copy to .env and customize for your environment

# Application
APP_NAME=SecondRoute
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# API
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://secondroute:changeme@localhost:5432/secondroute
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Pricing / Decision Engine
CONFIDENCE_THRESHOLD=0.70
MONTE_CARLO_SAMPLES=10000
RNG_SEED=42

# Risk Profiles (certainty equivalent lambda)
RISK_PROFILE_LAMBDA_CONSERVATIVE=2.0
RISK_PROFILE_LAMBDA_BALANCED=1.0
RISK_PROFILE_LAMBDA_AGGRESSIVE=0.5
DEFAULT_RISK_PROFILE=balanced

# Price Data
PRICE_RECENCY_HALF_LIFE_DAYS=30
MIN_PRICE_OBSERVATIONS=30

# Source Health
SOURCE_STALENESS_HOURS=48
CONFIDENCE_DEGRADATION_FACTOR=0.5

# External APIs
# EBAY_APP_ID=your-ebay-app-id
# EBAY_CERT_ID=your-ebay-cert-id
# EBAY_DEV_ID=your-ebay-dev-id
EBAY_SANDBOX=true

# FRED_API_KEY=your-fred-api-key

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=secondroute-pricing

# Ollama (for explanation text)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Monitoring
PROMETHEUS_METRICS_PORT=9090
# GRAFANA_URL=http://localhost:3000