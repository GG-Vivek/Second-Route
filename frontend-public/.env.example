# Where the Vite dev server forwards the API to.
#
# In the compose stack the backend answers to the service name and the
# request never leaves the compose network. On a developer machine the
# backend listens on the host, so the address is the one it actually
# listens on.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# The organisation whose stock the shop window shows.
#
# Outside production the backend accepts the tenant in this header, so
# that the window can be used without a deployment naming one. It is
# ignored in production, where PUBLIC_ORG_ID on the backend decides.
VITE_ORG_ID=
