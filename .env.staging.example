# The staging stack's configuration (Phase 5 - F5.8).
#
# Copy this file to .env.staging on the VM, fill it in, and keep it out
# of version control. The stack reads it with:
#
#     docker compose --env-file .env.staging \
#         -f docker-compose.yml -f docker-compose.staging.yml up -d --build
#
# Every value here is a secret or a setting for a real deployment. None of
# them has a usable default, and the stack refuses to start without them.

# --- The domain the stack is served on ---------------------------------
# Caddy requests a TLS certificate for it.
DOMAIN=staging.example.com
# The address Let's Encrypt uses to expire the certificate.
EMAIL=ops@example.com

# --- Secrets ------------------------------------------------------------
# At least 32 characters. Used to sign tokens.
SECRET_KEY=
# The PostgreSQL superuser. Owns the database; the application does not
# connect as it.
POSTGRES_PASSWORD=
# The role the application connects as. It is not a superuser, so the
# tenant-isolation policies apply to it.
POSTGRES_APP_USER=secondroute_app
POSTGRES_APP_PASSWORD=
# The role the backups use. It can read every tenant's rows, because a
# backup holds all of them: pg_dump refuses to dump a table whose rows the
# tenant-isolation policies would filter. It is a member of the
# application role, which is what gives it the privileges on the tables.
POSTGRES_BACKUP_USER=secondroute_app_backup
POSTGRES_BACKUP_PASSWORD=
# The database name.
POSTGRES_DB=secondroute

# --- Keycloak -----------------------------------------------------------
# The hostname Keycloak is served on.
KEYCLOAK_HOSTNAME=https://keycloak.example.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# The OIDC client the backend uses.
OIDC_REALM=secondroute
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Backups ------------------------------------------------------------
# Where the backups live. This must NOT be on the same machine as the
# database: a backup that dies with the server is not a backup.
#
# A free option that works with restic:
#   s3:https://<account-id>.r2.cloudflarestorage.com/secondroute
# or a second host over SSH:
#   sftp:backup@backup.example.com:/var/backups/secondroute
RESTIC_REPOSITORY=
# The password that unlocks the repository. Losing it loses the backups.
RESTIC_PASSWORD=
# How often the backup runs, in seconds. A day is 86400.
BACKUP_INTERVAL_SECONDS=86400

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
